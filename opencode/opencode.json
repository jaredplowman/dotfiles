    },
    "external_directory": {
      "~/.config/opencode/get-shit-done/*": "allow"
    }
  },
  "lsp": {
    "csharp": {
      "command": ["C:\\Users\\jared.plowman\\.dotnet\\tools\\csharp-ls.exe"],
      "extensions": [".cs"]
    },
    "clangd": {
      "command": ["C:\\Users\\jared.plowman\\.local\\opt\\clangd-23.1.0\\bin\\clangd.exe", "--background-index"],
