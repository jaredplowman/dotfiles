{
  "$schema": "https://opencode.ai/config.json",
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "github-copilot", "effect": "allow" }
  ],
  "providers": {
    "github-copilot": {
      "models": {
        "claude-opus-5": { "disabled": true },
        "claude-sonnet-5": { "disabled": true },
        "claude-opus-4.8": { "disabled": true },
        "claude-opus-4.8-fast": { "disabled": true },
        "claude-haiku-4.5": { "disabled": true },
        "gpt-5.6-luna": { "disabled": true },
        "gpt-5.6-sol": { "disabled": true },
        "gpt-5.6-terra": { "disabled": true },
        "gpt-5.3-codex": { "disabled": true },
        "grok-4.7": { "disabled": true },
        "grok-4.6": { "disabled": true },
        "mai-code-1.1-flash": { "disabled": true }
      }
    }
  },
  "plugins": ["./tui-worktree-indicator"],
  "permission": {
    "read": {
      "~/.config/opencode/get-shit-done/*": "allow"
    },
    "external_directory": {
      "~/.config/opencode/get-shit-done/*": "allow"
    }
  },
  "lsp": {
    "csharp": {
      "command": ["C:\\Users\\jared.plowman\\.dotnet\\tools\\csharp-ls.exe"],
      "extensions": [".cs"]
    },
    "clangd": {
      "command": ["C:\\Users\\jared.plowman\\.local\\opt\\clangd-23.1.0\\bin\\clangd.exe", "--background-index"],
      "extensions": [".c", ".cc", ".cpp", ".cxx", ".h", ".hh", ".hpp", ".hxx"]
    },
    "typescript": {
      "command": ["C:\\Program Files\\nodejs\\node.exe", "C:\\Users\\jared.plowman\\AppData\\Roaming\\npm\\node_modules\\typescript-language-server\\lib\\cli.mjs", "--stdio"],
      "extensions": [".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".mts", ".cts"]
    },
    "vue": {
      "command": ["C:\\Program Files\\nodejs\\node.exe", "C:\\Users\\jared.plowman\\AppData\\Roaming\\npm\\node_modules\\@vue\\language-server\\bin\\vue-language-server.js", "--stdio", "--tsdk=C:\\Users\\jared.plowman\\AppData\\Roaming\\npm\\node_modules\\typescript\\lib"],
      "extensions": [".vue"]
    },
    "json": {
      "command": ["C:\\Program Files\\nodejs\\node.exe", "C:\\Users\\jared.plowman\\AppData\\Roaming\\npm\\node_modules\\vscode-langservers-extracted\\bin\\vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc"]
    }
  }
}
